# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# --- Database / cache (docker-compose overrides these for containers) ---
DATABASE_URL=sqlite+aiosqlite:///./sara_dev.db
REDIS_URL=
POSTGRES_USER=sara
POSTGRES_DB=sara
POSTGRES_PASSWORD=change-me-long-random

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_HOURS=12
# true in production (HTTPS). false only for local http://localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Groq (free tier) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
GROQ_REASONING_EFFORT=medium

# --- Payments ---
# upi = Model B (free): travellers pay each vendor directly by UPI QR; each vendor confirms receipt before booking.
#       Sandbox vendors get demo UPI IDs (@sandbox) until an admin adds real vendor details.
# razorpay = automatic confirmation (needs Razorpay keys). mock = instant fake payments, automated tests ONLY.
PAYMENT_PROVIDER=upi
MERCHANT_NAME=Sara Explorer
# Comma-separated admin emails: manage vendors and confirm payments for demo vendors
ADMIN_EMAILS=
MOCK_PAYMENT_SECRET=change-me-long-random
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
