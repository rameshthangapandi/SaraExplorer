# Copy to .env and fill in. Never commit .env.

APP_ENV=development

# --- Database / cache (docker-compose overrides these for containers) ---
DATABASE_URL=sqlite+aiosqlite:///./sara_dev.db
REDIS_URL=
POSTGRES_USER=sara
POSTGRES_DB=sara
POSTGRES_PASSWORD=change-me-long-random

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_HOURS=12
# true in production (HTTPS). false only for local http://localhost
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Groq (free tier) ---
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3
GROQ_REASONING_EFFORT=medium

# --- Payments ---
# mock = free built-in test gateway (no account, no money). razorpay = needs Razorpay keys.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change-me-long-random
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
